# Todo lo que se calcula del dibujo funciona SIN estas variables: el
# configurador, la lectura de DXF, el despiece y el costeo corren en el
# navegador y no llaman a ninguna API. Las llaves solo hacen falta para
# leer IMAGENES: la pestana "Importar > desde imagen" y el boton
# "Proponer armado" del modulo CNC.
#
# Configura UNO de los dos proveedores. Si hay llave de OpenRouter, esa gana.

# --- Opcion A: OpenRouter (una llave, muchos modelos) ---
OPENROUTER_API_KEY=sk-or-v1-...
# Identificador exacto tal como aparece en openrouter.ai/models.
# OJO: tiene que ser un modelo con VISION; las dos rutas mandan una imagen.
OPENROUTER_MODEL=moonshotai/kimi-k3
# Opcional. OpenRouter lo usa para atribuir el trafico a tu app.
OPENROUTER_SITE_URL=https://tu-app.vercel.app
# Opcional, por defecto 4000. Los modelos de razonamiento gastan tokens
# pensando ANTES de escribir: si se quedan cortos devuelven una respuesta
# vacia en vez de un error claro. Subelo si eso pasa.
OPENROUTER_MAX_TOKENS=4000

# Opcional, por defecto 45000 ms. Cuanto se espera al modelo antes de
# abortar. Debe quedar POR DEBAJO del limite de duracion de la funcion en
# tu plan, para que la app pueda devolver un error legible en vez de que
# la plataforma corte con su propia pagina de error.
LLM_TIMEOUT_MS=45000

# Opcional, APAGADO por defecto. Cuanto deja pensar al modelo antes de
# responder: off | low | medium | high, o un numero de tokens como tope.
# Leer una referencia es extraer unos campos, no razonar. Un modelo de
# razonamiento puede gastarse el presupuesto entero pensando y no llegar a
# contestar, lo que desde fuera se ve como un timeout.
OPENROUTER_REASONING=off

# --- Opcion B: Anthropic directo ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
